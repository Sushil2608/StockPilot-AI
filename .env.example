# ==============================================
# StockPilot AI — Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Choose an LLM provider: anthropic or openai_compatible
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI-compatible AI proxy (Codex and other proxy-hosted models)
# Set these in hosting secrets instead of putting a real key in this file.
# LLM_PROVIDER=openai_compatible
# AI_PROXY_API_KEY=your-proxy-key
# AI_PROXY_BASE_URL=https://your-proxy.example/v1
# MODEL_NAME=the-model-id-provided-by-your-proxy
# OPENAI_USE_RESPONSES_API=false

# Model configuration
MODEL_NAME=claude-sonnet-4-6
MODEL_TEMPERATURE=0.3

# Application
APP_NAME=StockPilot AI
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the backend.
# For Vercel, set this in the backend project's environment variables.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000
