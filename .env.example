# ==============================================
# StockPilot AI — Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Choose a direct LLM provider: gemini, openai, or anthropic
LLM_PROVIDER=gemini

# Gemini (used when LLM_PROVIDER=gemini)
# Get a Gemini API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-api-key-here
# Gemini 3.5 Flash-Lite supports function calling and structured output.
MODEL_NAME=gemini-3.5-flash-lite

# OpenAI (optional; set LLM_PROVIDER=openai to use it)
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (optional; set LLM_PROVIDER=anthropic to use it)
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model configuration
MODEL_TEMPERATURE=0.3
ANALYSIS_TIMEOUT_SECONDS=180
TICKER_VALIDATION_TIMEOUT_SECONDS=15
ANALYSIS_RATE_LIMIT_COUNT=5
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=600

# Application
APP_NAME=StockPilot AI
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the backend.
# For Vercel, set this in the backend project's environment variables.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000
